{
  "name": "web-revision-desk",
  "version": "0.3.0",
  "private": true,
  "description": "Capture, edit, compare, and create clear revision instructions for existing web pages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MZ-Gen-Labs/WebRevisionDesk.git"
  },
  "homepage": "https://github.com/MZ-Gen-Labs/WebRevisionDesk",
  "bugs": {
    "url": "https://github.com/MZ-Gen-Labs/WebRevisionDesk/issues"
  },
  "type": "module",
  "portable": {
    "nodeVersion": "24.18.0"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "vite build",
    "build:portable": "node scripts/build-windows-portable.mjs",
    "version:check": "node scripts/check-version.mjs",
    "preview": "vite preview",
    "test": "npm run version:check && npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node --test --test-timeout=60000 tests/e2e/*.test.js"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
