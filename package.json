{
  "name": "web-revision-desk",
  "version": "0.7.13",
  "main": "electron/main.mjs",
  "private": true,
  "description": "Capture, edit, compare, and create clear revision instructions for existing web pages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MZ-Gen-Labs/WebRevisionDesk.git"
  },
  "homepage": "https://github.com/MZ-Gen-Labs/WebRevisionDesk",
  "bugs": {
    "url": "https://github.com/MZ-Gen-Labs/WebRevisionDesk/issues"
  },
  "type": "module",
  "portable": {
    "nodeVersion": "24.18.0"
  },
  "scripts": {
    "electron:dev": "npm run build && electron electron/main.mjs",
    "electron:feasibility": "electron electron/main.mjs --feasibility-ui",
    "electron:package:win": "node scripts/build-electron-feasibility.mjs",
    "electron:migration:package:win": "npm run build && node scripts/build-electron-migration.mjs",
    "build:electron:win": "npm run build && node scripts/build-electron-migration.mjs",
    "build:windows:installer": "node scripts/build-windows-installer.mjs",
    "build:electron:mac": "npm run build && node scripts/build-electron-mac.mjs",
    "build": "vite build",
    "version:check": "node scripts/check-version.mjs",
    "preview": "vite preview",
    "test": "npm run version:check && npm run test:unit && npm run build",
    "test:unit": "node --test tests/unit/*.test.js"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "jsdom": "^30.1.0",
    "vite": "^8.3.0"
  }
}
